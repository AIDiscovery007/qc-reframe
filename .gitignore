# Track the browser extension, engineering tools and project documentation.
# Local skills, experiments, downloaded images and prompts remain on disk.
/*
!/.gitignore
!/README.md
!/Contribution.md
!/AGENTS.md
!/GLOSSARY.md
!/browser-extension/
!/agent-tool/

# Track repository skills only; local Claude settings stay ignored.
!/.claude/
/.claude/*
!/.claude/skills/

# Track only the four engineering standards.
!/docs/
/docs/*
!/docs/standards/
/docs/standards/*
!/docs/standards/code.md
!/docs/standards/frontend.md
!/docs/standards/backend.md
!/docs/standards/review.md

# Explicit verification workflows only.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/uiux.yml
!/.github/workflows/release.yml
