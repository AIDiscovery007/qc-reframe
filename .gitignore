# Track the browser extension, engineering tools and collaboration documents.
# Local skills, experiments, downloaded images and prompts remain on disk.
/*
!/.gitignore
!/README.md
!/Contribution.md
!/AGENTS.md
!/GLOSSARY.md
# Session logs stay on this machine and are not distributed by clone.
/agent-logs/
!/browser-extension/
!/agent-tool/

# Track only collaboration role documents; keep local skills and other agent data ignored.
!/.agents/
/.agents/*
!/.agents/roles/
/.agents/roles/*
!/.agents/roles/supervisor.md
!/.agents/roles/project-manager.md
!/.agents/roles/executor.md
!/.agents/roles/uiux-engineer.md
!/.agents/roles/architecture-engineer.md
!/.agents/roles/assignments.md

# Explicit verification workflows only.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/uiux.yml
!/.github/workflows/test-full.yml
